{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "(curl -s --connect-timeout 1 -m 2 'http://lampada.local/claude?state=busy' >/dev/null 2>&1 &); true" } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [ { "type": "command",
        "command": "(curl -s --connect-timeout 1 -m 2 'http://lampada.local/claude?state=ask' >/dev/null 2>&1 &); true" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command",
        "command": "(curl -s --connect-timeout 1 -m 2 'http://lampada.local/claude?state=busy' >/dev/null 2>&1 &); true" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command",
        "command": "(curl -s --connect-timeout 1 -m 2 'http://lampada.local/claude?state=ok' >/dev/null 2>&1 &); true" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command",
        "command": "(curl -s --connect-timeout 1 -m 2 'http://lampada.local/claude?state=off' >/dev/null 2>&1 &); true" } ] }
    ]
  }
}
